<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Appointment | Just Vitality Clinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: '#C9A96E',
                        burgundy: '#8B1538',
                        teal: '#1A5F6E',
                        forest: '#1A5E3A',
                        dark: '#0f1115',
                        card: '#15171c'
                    },
                    fontFamily: {
                        playfair: ['Playfair Display', 'serif'],
                        manrope: ['Manrope', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Manrope', sans-serif; 
            background-color: #0f1115; 
            color: #f8fafc;
            line-height: 1.6;
        }
        h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', serif; }
        
        .glass {
            background: rgba(15, 17, 21, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .service-item {
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
        }
        
        .service-item.selected {
            border-color: #C9A96E;
            background: rgba(201, 169, 110, 0.1);
        }
        
        .checkbox-custom {
            width: 24px;
            height: 24px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        
        .checkbox-custom.checked {
            background: #C9A96E;
            border-color: #C9A96E;
        }
        
        .time-slot {
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.2s;
        }
        
        .time-slot:hover {
            border-color: #C9A96E;
            background: rgba(201, 169, 110, 0.1);
        }
        
        .time-slot.selected {
            border-color: #C9A96E;
            background: #C9A96E;
            color: #0f1115;
        }
        
        .payment-option {
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.2s;
        }
        
        .payment-option.selected {
            border-color: #C9A96E;
            background: rgba(201, 169, 110, 0.1);
        }
        
        .step-number {
            transition: all 0.3s;
        }
        
        .step-connector {
            transition: background-color 0.3s;
        }
        
        input:focus, textarea:focus {
            outline: none;
            border-color: rgba(201, 169, 110, 0.5);
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="glass sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <a href="index.html" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    <span class="hidden sm:inline">Back</span>
                </a>
                <a href="index.html" class="flex items-center gap-2">
                    <img src="https://customer-assets.emergentagent.com/job_c94923ea-8994-408c-82c5-8ba06f7c7bb7/artifacts/2skstidw_logo.jpeg" alt="Just Vitality Clinic" class="h-8 w-8 rounded-lg object-cover">
                    <span class="text-gold font-medium hidden sm:inline font-playfair">Just Vitality Clinic</span>
                </a>
                <div class="w-20"></div>
            </div>
        </div>
    </header>

    <!-- Progress Steps -->
    <div class="max-w-4xl mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center">
                <div class="step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-gold text-dark" id="step1-indicator">1</div>
                <span class="hidden md:block mt-0 ml-2 text-xs text-white">Services</span>
            </div>
            <div class="w-8 sm:w-16 h-0.5 mx-1 sm:mx-2 bg-white/10 step-connector" id="connector1"></div>
            <div class="flex items-center">
                <div class="step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-white/10 text-gray-500" id="step2-indicator">2</div>
                <span class="hidden md:block mt-0 ml-2 text-xs text-gray-500" id="step2-label">Date & Time</span>
            </div>
            <div class="w-8 sm:w-16 h-0.5 mx-1 sm:mx-2 bg-white/10 step-connector" id="connector2"></div>
            <div class="flex items-center">
                <div class="step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-white/10 text-gray-500" id="step3-indicator">3</div>
                <span class="hidden md:block mt-0 ml-2 text-xs text-gray-500" id="step3-label">Details</span>
            </div>
            <div class="w-8 sm:w-16 h-0.5 mx-1 sm:mx-2 bg-white/10 step-connector" id="connector3"></div>
            <div class="flex items-center">
                <div class="step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-white/10 text-gray-500" id="step4-indicator">4</div>
                <span class="hidden md:block mt-0 ml-2 text-xs text-gray-500" id="step4-label">Health</span>
            </div>
            <div class="w-8 sm:w-16 h-0.5 mx-1 sm:mx-2 bg-white/10 step-connector" id="connector4"></div>
            <div class="flex items-center">
                <div class="step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-white/10 text-gray-500" id="step5-indicator">5</div>
                <span class="hidden md:block mt-0 ml-2 text-xs text-gray-500" id="step5-label">Payment</span>
            </div>
        </div>

        <!-- Selected Services Summary (hidden initially) -->
        <div id="selected-summary" class="hidden bg-gold/10 border border-gold/20 rounded-xl p-4 mb-6">
            <div class="flex flex-wrap gap-2 items-center">
                <span class="text-sm text-gold font-medium">Selected:</span>
                <div id="selected-pills" class="flex flex-wrap gap-2"></div>
                <span class="ml-auto text-gold font-semibold" id="total-summary">£0 • 0 min</span>
            </div>
        </div>

        <!-- Step Content -->
        <div class="bg-card border border-white/10 rounded-2xl p-6 md:p-8">
            
            <!-- Step 1: Services -->
            <div id="step1" class="step-content">
                <h2 class="text-2xl md:text-3xl font-medium text-white mb-2 font-playfair">Select Your Treatments</h2>
                <p class="text-gray-400 mb-4">Choose one or more treatments to combine</p>

                <!-- Selection Box -->
                <div id="selection-box" class="hidden bg-white/[0.02] border border-white/10 rounded-xl p-4 mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm text-gray-400">Your selection:</span>
                        <span class="text-gold font-semibold" id="selection-total">£0 total • 0 min</span>
                    </div>
                    <div id="selection-tags" class="flex flex-wrap gap-2"></div>
                </div>

                <!-- Services List -->
                <div class="space-y-8">
                    <!-- IV Therapy -->
                    <div>
                        <h3 class="text-lg font-medium text-white mb-4">IV Therapy</h3>
                        <div class="space-y-3" id="iv-services"></div>
                    </div>
                    
                    <!-- Physiotherapy -->
                    <div>
                        <h3 class="text-lg font-medium text-white mb-4">Physiotherapy</h3>
                        <div class="space-y-3" id="physio-services"></div>
                    </div>
                    
                    <!-- Advanced -->
                    <div>
                        <h3 class="text-lg font-medium text-white mb-4">Advanced Treatments & Blood Tests</h3>
                        <div class="space-y-3" id="advanced-services"></div>
                    </div>
                </div>

                <div class="flex justify-end mt-8">
                    <button onclick="goToStep(2)" class="bg-gold text-dark hover:bg-gold/90 rounded-full px-8 py-3 font-medium flex items-center gap-2 disabled:opacity-50" id="continue-btn" disabled>
                        Continue with <span id="continue-count">0</span> treatment(s)
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- Step 2: Date & Time -->
            <div id="step2" class="step-content hidden">
                <h2 class="text-2xl md:text-3xl font-medium text-white mb-2 font-playfair">Choose Date & Time</h2>
                <p class="text-gray-400 mb-8">Select when you'd like to visit</p>

                <div class="grid md:grid-cols-2 gap-8">
                    <div>
                        <label class="text-white mb-4 block">Select Date</label>
                        <div class="bg-white/[0.02] border border-white/10 rounded-xl p-4">
                            <input type="date" id="booking-date" class="w-full bg-transparent text-white text-lg" min="">
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Monday - Saturday, 09:00 - 18:00</p>
                    </div>
                    
                    <div>
                        <label class="text-white mb-4 block">Select Time</label>
                        <div id="time-slots" class="grid grid-cols-3 gap-2 max-h-[300px] overflow-y-auto">
                            <p class="col-span-3 text-center text-gray-500 py-8">Please select a date first</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end mt-8">
                    <button onclick="goToStep(3)" class="bg-gold text-dark hover:bg-gold/90 rounded-full px-8 py-3 font-medium flex items-center gap-2 disabled:opacity-50" id="step2-continue" disabled>
                        Continue
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- Step 3: Customer Details -->
            <div id="step3" class="step-content hidden">
                <h2 class="text-2xl md:text-3xl font-medium text-white mb-2 font-playfair">Your Details</h2>
                <p class="text-gray-400 mb-8">Please provide your contact information</p>

                <div class="max-w-md space-y-6">
                    <div>
                        <label class="text-white mb-2 block">Full Name</label>
                        <input type="text" id="customer-name" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white" placeholder="John Smith">
                    </div>
                    <div>
                        <label class="text-white mb-2 block">Email Address</label>
                        <input type="email" id="customer-email" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white" placeholder="john@example.com">
                    </div>
                    <div>
                        <label class="text-white mb-2 block">Phone Number</label>
                        <input type="tel" id="customer-phone" class="w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-white" placeholder="07123 456789">
                    </div>
                </div>

                <div class="flex justify-end mt-8">
                    <button onclick="goToStep(4)" class="bg-gold text-dark hover:bg-gold/90 rounded-full px-8 py-3 font-medium flex items-center gap-2">
                        Continue to Health Check
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- Step 4: Health Screening -->
            <div id="step4" class="step-content hidden">
                <div class="flex items-center gap-3 mb-2">
                    <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                    <h2 class="text-2xl md:text-3xl font-medium text-white font-playfair">Health Screening</h2>
                </div>
                <p class="text-gray-400 mb-8">Please answer the following questions to ensure your safety.</p>

                <div id="health-questions" class="space-y-4 mb-8"></div>

                <div class="flex justify-end mt-8">
                    <button onclick="goToStep(5)" class="bg-gold text-dark hover:bg-gold/90 rounded-full px-8 py-3 font-medium flex items-center gap-2" id="step4-continue">
                        Continue to Payment
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- Step 5: Payment -->
            <div id="step5" class="step-content hidden">
                <h2 class="text-2xl md:text-3xl font-medium text-white mb-2 font-playfair">Booking Summary</h2>
                <p class="text-gray-400 mb-8">Please review your booking before payment</p>

                <div class="bg-white/[0.02] rounded-xl border border-white/10 p-6 mb-6">
                    <div id="booking-summary" class="space-y-4"></div>
                </div>

                <!-- Payment Options -->
                <div class="bg-white/[0.02] rounded-xl border border-white/10 p-6 mb-8">
                    <h3 class="text-lg font-medium text-white mb-4 font-playfair">Payment Option</h3>
                    
                    <div class="space-y-4">
                        <div class="payment-option selected rounded-xl p-4 cursor-pointer" onclick="selectPayment('full')" id="payment-full">
                            <div class="flex items-start gap-4">
                                <div class="w-5 h-5 rounded-full border-2 border-gold flex items-center justify-center mt-1">
                                    <div class="w-2.5 h-2.5 rounded-full bg-gold" id="radio-full"></div>
                                </div>
                                <div class="flex-1">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <div class="font-medium text-white">Pay in Full</div>
                                            <div class="text-sm text-gray-400 mt-1">Pay the full amount now and secure your booking</div>
                                        </div>
                                        <div class="text-gold font-semibold text-lg" id="full-price">£0.00</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="payment-option rounded-xl p-4 cursor-pointer" onclick="selectPayment('deposit')" id="payment-deposit">
                            <div class="flex items-start gap-4">
                                <div class="w-5 h-5 rounded-full border-2 border-white/30 flex items-center justify-center mt-1" id="radio-deposit-outer">
                                    <div class="w-2.5 h-2.5 rounded-full hidden" id="radio-deposit"></div>
                                </div>
                                <div class="flex-1">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <div class="font-medium text-white flex items-center gap-2">
                                                Pay 30% Deposit
                                                <span class="inline-flex items-center gap-1 bg-teal/20 text-teal text-xs px-2 py-0.5 rounded-full">Popular</span>
                                            </div>
                                            <div class="text-sm text-gray-400 mt-1" id="deposit-desc">Pay £0 now, remaining £0 at the clinic</div>
                                        </div>
                                        <div class="text-gold font-semibold text-lg" id="deposit-price">£0.00</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 justify-end">
                    <button onclick="goToStep(4)" class="border border-white/20 text-white hover:bg-white/5 rounded-full px-8 py-3 font-medium">
                        Edit Details
                    </button>
                    <button onclick="processPayment()" class="bg-gold text-dark hover:bg-gold/90 rounded-full px-8 py-3 font-medium flex items-center justify-center gap-2" id="pay-btn">
                        Pay <span id="pay-amount">£0.00</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Services data
        const services = {
            iv: [
                { id: 'mega-recovery', name: 'Mega Recovery', price: 150, duration: 60, category: 'IV Therapy' },
                { id: 'immunity-shield', name: 'Immunity Shield', price: 135, duration: 45, category: 'IV Therapy' },
                { id: 'sport-performance', name: 'Sport Performance', price: 150, duration: 60, category: 'IV Therapy' },
                { id: 'energy-booster', name: 'Energy Booster', price: 125, duration: 40, category: 'IV Therapy' },
                { id: 'glutathione-glow', name: 'Glutathione Glow', price: 145, duration: 45, category: 'IV Therapy' },
                { id: 'b12-shot', name: 'B12 Vitamin Shot', price: 30, duration: 15, category: 'Vitamin Shots' }
            ],
            physio: [
                { id: 'physio-consultation', name: 'Physio Consultation', price: 60, duration: 60, category: 'Physiotherapy' },
                { id: 'sports-massage', name: 'Sports & Deep Tissue Massage', price: 55, duration: 45, category: 'Physiotherapy' },
                { id: 'acupuncture', name: 'Medical Acupuncture', price: 50, duration: 30, category: 'Physiotherapy' }
            ],
            advanced: [
                { id: 'ozone-therapy', name: 'Ozone Therapy', price: 180, duration: 30, category: 'Advanced Treatments' },
                { id: 'blood-profile', name: 'Advanced Health Profile', price: 60, duration: 15, category: 'Blood Tests' }
            ]
        };

        // Health questions by category
        const healthQuestions = {
            iv: [
                { id: 'pregnancy', question: 'Are you currently pregnant or breastfeeding?', blocking: true },
                { id: 'allergies', question: 'Do you have any known allergies to vitamins, minerals, or injectable medications?', blocking: false },
                { id: 'kidney', question: 'Have you been diagnosed with kidney disease or are you on dialysis?', blocking: true },
                { id: 'heart', question: 'Do you have heart failure or fluid retention issues?', blocking: true },
                { id: 'medications', question: 'Are you currently taking blood thinners or chemotherapy medications?', blocking: false }
            ],
            physio: [
                { id: 'recent-injury', question: 'Have you had any recent surgery or acute injury in the last 6 weeks?', blocking: false },
                { id: 'skin-conditions', question: 'Do you have any open wounds, skin infections, or contagious conditions?', blocking: true },
                { id: 'blood-clots', question: 'Have you been diagnosed with deep vein thrombosis (DVT) or blood clots?', blocking: true },
                { id: 'medical-conditions', question: 'Do you have any medical conditions we should be aware of?', blocking: false }
            ]
        };

        let selectedServices = [];
        let selectedDate = '';
        let selectedTime = '';
        let paymentType = 'full';
        let healthAnswers = {};

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            renderServices();
            setMinDate();
        });

        function renderServices() {
            const ivContainer = document.getElementById('iv-services');
            const physioContainer = document.getElementById('physio-services');
            const advancedContainer = document.getElementById('advanced-services');

            services.iv.forEach(s => ivContainer.innerHTML += createServiceHTML(s));
            services.physio.forEach(s => physioContainer.innerHTML += createServiceHTML(s));
            services.advanced.forEach(s => advancedContainer.innerHTML += createServiceHTML(s));
        }

        function createServiceHTML(service) {
            return `
                <div class="service-item rounded-xl border border-white/10 p-4 cursor-pointer transition-all" onclick="toggleService('${service.id}')" id="service-${service.id}">
                    <div class="flex items-start gap-4">
                        <div class="checkbox-custom flex-shrink-0 mt-0.5" id="checkbox-${service.id}">
                            <svg class="w-4 h-4 text-dark hidden" id="check-${service.id}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start gap-4">
                                <div class="font-medium text-white">${service.name}</div>
                                <div class="text-right flex-shrink-0">
                                    <div class="text-gold font-semibold">£${service.price}</div>
                                    <div class="text-xs text-gray-500">${service.duration} min</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function toggleService(id) {
            const allServices = [...services.iv, ...services.physio, ...services.advanced];
            const service = allServices.find(s => s.id === id);
            
            const index = selectedServices.findIndex(s => s.id === id);
            if (index > -1) {
                selectedServices.splice(index, 1);
            } else {
                selectedServices.push(service);
            }
            
            updateServiceUI();
        }

        function updateServiceUI() {
            const allServices = [...services.iv, ...services.physio, ...services.advanced];
            
            allServices.forEach(service => {
                const isSelected = selectedServices.some(s => s.id === service.id);
                const element = document.getElementById(`service-${service.id}`);
                const checkbox = document.getElementById(`checkbox-${service.id}`);
                const check = document.getElementById(`check-${service.id}`);
                
                if (isSelected) {
                    element.classList.add('selected');
                    checkbox.classList.add('checked');
                    check.classList.remove('hidden');
                } else {
                    element.classList.remove('selected');
                    checkbox.classList.remove('checked');
                    check.classList.add('hidden');
                }
            });

            const total = selectedServices.reduce((sum, s) => sum + s.price, 0);
            const duration = selectedServices.reduce((sum, s) => sum + s.duration, 0);
            
            document.getElementById('continue-count').textContent = selectedServices.length;
            document.getElementById('continue-btn').disabled = selectedServices.length === 0;
            
            const selectionBox = document.getElementById('selection-box');
            if (selectedServices.length > 0) {
                selectionBox.classList.remove('hidden');
                document.getElementById('selection-total').textContent = `£${total} total • ${duration} min`;
                document.getElementById('selection-tags').innerHTML = selectedServices.map(s => 
                    `<span class="inline-flex items-center gap-2 bg-gold/20 text-gold text-sm px-3 py-2 rounded-lg">${s.name} (£${s.price})<button onclick="event.stopPropagation(); removeService('${s.id}')" class="hover:text-white">×</button></span>`
                ).join('');
            } else {
                selectionBox.classList.add('hidden');
            }
        }

        function removeService(id) {
            selectedServices = selectedServices.filter(s => s.id !== id);
            updateServiceUI();
        }

        function setMinDate() {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('booking-date').min = tomorrow.toISOString().split('T')[0];
            
            document.getElementById('booking-date').addEventListener('change', function() {
                selectedDate = this.value;
                generateTimeSlots();
            });
        }

        function generateTimeSlots() {
            const container = document.getElementById('time-slots');
            const date = new Date(selectedDate);
            
            // Check if Sunday
            if (date.getDay() === 0) {
                container.innerHTML = '<p class="col-span-3 text-center text-gray-500 py-8">Clinic is closed on Sundays</p>';
                return;
            }
            
            const slots = [];
            for (let hour = 9; hour <= 17; hour++) {
                for (let min of [0, 30]) {
                    if (hour === 17 && min === 30) continue;
                    const time = `${hour.toString().padStart(2, '0')}:${min.toString().padStart(2, '0')}`;
                    slots.push(time);
                }
            }
            
            container.innerHTML = slots.map(time => 
                `<button class="time-slot p-3 rounded-lg text-center text-sm font-medium" onclick="selectTime('${time}')" id="slot-${time.replace(':', '')}">${time}</button>`
            ).join('');
        }

        function selectTime(time) {
            document.querySelectorAll('.time-slot').forEach(el => el.classList.remove('selected'));
            document.getElementById(`slot-${time.replace(':', '')}`).classList.add('selected');
            selectedTime = time;
            document.getElementById('step2-continue').disabled = false;
        }

        function goToStep(step) {
            // Hide all steps
            document.querySelectorAll('.step-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`step${step}`).classList.remove('hidden');
            
            // Update indicators
            for (let i = 1; i <= 5; i++) {
                const indicator = document.getElementById(`step${i}-indicator`);
                const label = document.getElementById(`step${i}-label`);
                const connector = document.getElementById(`connector${i-1}`);
                
                if (i < step) {
                    indicator.className = 'step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-forest text-white';
                    indicator.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
                    if (label) label.className = 'hidden md:block mt-0 ml-2 text-xs text-white';
                    if (connector) connector.className = 'w-8 sm:w-16 h-0.5 mx-1 sm:mx-2 bg-gold step-connector';
                } else if (i === step) {
                    indicator.className = 'step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-gold text-dark';
                    indicator.textContent = i;
                    if (label) label.className = 'hidden md:block mt-0 ml-2 text-xs text-white';
                } else {
                    indicator.className = 'step-number w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-xs sm:text-sm font-medium bg-white/10 text-gray-500';
                    indicator.textContent = i;
                    if (label) label.className = 'hidden md:block mt-0 ml-2 text-xs text-gray-500';
                }
            }
            
            // Show selected summary on steps 2+
            const summary = document.getElementById('selected-summary');
            if (step > 1 && selectedServices.length > 0) {
                summary.classList.remove('hidden');
                const total = selectedServices.reduce((sum, s) => sum + s.price, 0);
                const duration = selectedServices.reduce((sum, s) => sum + s.duration, 0);
                document.getElementById('total-summary').textContent = `£${total} • ${duration} min`;
                document.getElementById('selected-pills').innerHTML = selectedServices.map(s => 
                    `<span class="inline-flex items-center bg-gold/20 text-gold text-sm px-3 py-1 rounded-full">${s.name}</span>`
                ).join('');
            } else {
                summary.classList.add('hidden');
            }
            
            // Step-specific logic
            if (step === 4) {
                renderHealthQuestions();
            }
            if (step === 5) {
                renderBookingSummary();
            }
        }

        function renderHealthQuestions() {
            const container = document.getElementById('health-questions');
            const hasIV = selectedServices.some(s => ['IV Therapy', 'Vitamin Shots', 'Blood Tests', 'Advanced Treatments'].includes(s.category));
            const hasPhysio = selectedServices.some(s => s.category === 'Physiotherapy');
            
            let questions = [];
            if (hasIV) questions = [...questions, ...healthQuestions.iv];
            if (hasPhysio) questions = [...questions, ...healthQuestions.physio];
            
            // Remove duplicates
            questions = questions.filter((q, index, self) => index === self.findIndex(t => t.id === q.id));
            
            container.innerHTML = questions.map((q, i) => `
                <div class="bg-white/[0.02] border border-white/10 rounded-xl p-5">
                    <div class="flex justify-between items-start gap-4">
                        <p class="text-white"><span class="text-gold font-medium mr-2">${i+1}.</span>${q.question}</p>
                        <div class="flex gap-3 flex-shrink-0">
                            <button onclick="answerHealth('${q.id}', true)" class="px-4 py-2 rounded-lg text-sm font-medium bg-white/5 text-gray-400 hover:bg-white/10 transition-colors" id="health-${q.id}-yes">Yes</button>
                            <button onclick="answerHealth('${q.id}', false)" class="px-4 py-2 rounded-lg text-sm font-medium bg-white/5 text-gray-400 hover:bg-white/10 transition-colors" id="health-${q.id}-no">No</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function answerHealth(id, value) {
            healthAnswers[id] = value;
            
            const yesBtn = document.getElementById(`health-${id}-yes`);
            const noBtn = document.getElementById(`health-${id}-no`);
            
            if (value) {
                yesBtn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-gold text-dark';
                noBtn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-white/5 text-gray-400 hover:bg-white/10 transition-colors';
            } else {
                noBtn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-forest text-white';
                yesBtn.className = 'px-4 py-2 rounded-lg text-sm font-medium bg-white/5 text-gray-400 hover:bg-white/10 transition-colors';
            }
        }

        function renderBookingSummary() {
            const total = selectedServices.reduce((sum, s) => sum + s.price, 0);
            const duration = selectedServices.reduce((sum, s) => sum + s.duration, 0);
            const deposit = total * 0.3;
            
            const dateObj = new Date(selectedDate);
            const formattedDate = dateObj.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            
            document.getElementById('booking-summary').innerHTML = `
                <div class="py-3 border-b border-white/10">
                    <span class="text-gray-400 block mb-2">Treatments</span>
                    ${selectedServices.map(s => `<div class="flex justify-between text-white"><span>${s.name} <span class="text-gray-500 text-sm">(${s.duration} min)</span></span><span>£${s.price}</span></div>`).join('')}
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Date</span>
                    <span class="text-white">${formattedDate}</span>
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Time</span>
                    <span class="text-white">${selectedTime}</span>
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Total Duration</span>
                    <span class="text-white">${duration} minutes</span>
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Name</span>
                    <span class="text-white">${document.getElementById('customer-name').value}</span>
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Email</span>
                    <span class="text-white">${document.getElementById('customer-email').value}</span>
                </div>
                <div class="flex justify-between py-3 border-b border-white/10">
                    <span class="text-gray-400">Phone</span>
                    <span class="text-white">${document.getElementById('customer-phone').value}</span>
                </div>
                <div class="flex justify-between py-4">
                    <span class="text-lg font-medium text-white">Total</span>
                    <span class="text-2xl font-semibold text-gold">£${total.toFixed(2)}</span>
                </div>
            `;
            
            document.getElementById('full-price').textContent = `£${total.toFixed(2)}`;
            document.getElementById('deposit-price').textContent = `£${deposit.toFixed(2)}`;
            document.getElementById('deposit-desc').textContent = `Pay £${deposit.toFixed(2)} now, remaining £${(total - deposit).toFixed(2)} at the clinic`;
            
            updatePaymentButton();
        }

        function selectPayment(type) {
            paymentType = type;
            
            const fullOption = document.getElementById('payment-full');
            const depositOption = document.getElementById('payment-deposit');
            const radioFull = document.getElementById('radio-full');
            const radioDeposit = document.getElementById('radio-deposit');
            const radioDepositOuter = document.getElementById('radio-deposit-outer');
            
            if (type === 'full') {
                fullOption.classList.add('selected');
                depositOption.classList.remove('selected');
                radioFull.classList.remove('hidden');
                radioDeposit.classList.add('hidden');
                radioDepositOuter.classList.remove('border-gold');
                radioDepositOuter.classList.add('border-white/30');
            } else {
                depositOption.classList.add('selected');
                fullOption.classList.remove('selected');
                radioDeposit.classList.remove('hidden');
                radioDeposit.classList.add('bg-gold');
                radioFull.classList.add('hidden');
                radioDepositOuter.classList.add('border-gold');
                radioDepositOuter.classList.remove('border-white/30');
            }
            
            updatePaymentButton();
        }

        function updatePaymentButton() {
            const total = selectedServices.reduce((sum, s) => sum + s.price, 0);
            const amount = paymentType === 'full' ? total : total * 0.3;
            document.getElementById('pay-amount').textContent = `£${amount.toFixed(2)}`;
        }

        function processPayment() {
            alert('This is a demo. In the live version, this would redirect to Stripe checkout for secure payment processing.');
        }
    </script>
</body>
</html>
